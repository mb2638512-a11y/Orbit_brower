{
  "expo": {
    "name": "Orbit",
    "slug": "orbit-browser",
    "scheme": "orbitbrowser",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "android": {
      "package": "com.orbitbrowser.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/orbit-icon.png",
        "backgroundColor": "#101d2d"
      }
    },
    "ios": {
      "bundleIdentifier": "com.orbitbrowser.app"
    },
    "icon": "./assets/orbit-icon.png"
  }
}