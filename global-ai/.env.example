# Copy to .env on your private server. Never put real keys in the app or commit them.
SEARXNG_URL=http://searxng:8080
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-server-side-secret
AI_MODEL=replace-with-model-supported-by-your-provider
CORS_ORIGINS=* # local testing only; set explicit trusted origins for production
RATE_LIMIT_PER_MINUTE=30
